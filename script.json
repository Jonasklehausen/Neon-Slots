// Konfiguration der Symbole & Wahrscheinlichkeiten
const SYMBOLS = [
    { icon: '🍒', multiplier: 3, weight: 35 },
    { icon: '🍋', multiplier: 5, weight: 25 },
    { icon: '🍇', multiplier: 10, weight: 18 },
    { icon: '🔔', multiplier: 15, weight: 12 },
    { icon: '💎', multiplier: 25, weight: 7 },
    { icon: '7️⃣', multiplier: 50, weight: 3 }
];

// Spielzustand (wird im LocalStorage gespeichert, damit Guthaben beim Neuladen bleibt)
let balance = parseFloat(localStorage.getItem('slot_balance')) || 1000;
let currentBet = 10;
let isSpinning = false;

// DOM Elemente
const balanceEl = document.getElementById('balance');
const betAmountEl = document.getElementById('bet-amount');
const lastWinEl = document.getElementById('last-win-amount');
const statusEl = document.getElementById('status-message');
const spinBtn = document.getElementById('spin-btn');
const reels = [
    document.getElementById('reel1'),
    document.getElementById('reel2'),
    document.getElementById('reel3')
];

// UI initialisieren
function updateUI() {
    balanceEl.textContent = balance.toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' €';
    betAmountEl.textContent = currentBet + ' €';
    localStorage.setItem('slot_balance', balance);
}

// Gewichtetes Zufallssymbol ziehen
function getRandomSymbol() {
    const totalWeight = SYMBOLS.reduce((sum, s) => sum + s.weight, 0);
    let random = Math.random() * totalWeight;
    for (const symbol of SYMBOLS) {
        if (random < symbol.weight) return symbol;
        random -= symbol.weight;
    }
    return SYMBOLS[0];
}

// Einsatz anpassen
document.getElementById('bet-minus').addEventListener('click', () => {
    if (!isSpinning && currentBet > 5) {
        currentBet -= 5;
        updateUI();
    }
});

document.getElementById('bet-plus').addEventListener('click', () => {
    if (!isSpinning && currentBet < 100 && currentBet + 5 <= balance) {
        currentBet += 5;
        updateUI();
    }
});

// Guthaben aufladen (Demo-Funktion)
document.getElementById('refill-btn').addEventListener('click', () => {
    if (!isSpinning) {
        balance += 500;
        statusEl.textContent = '+500,00 € Spielgeld aufgeladen!';
        statusEl.classList.remove('status-win');
        updateUI();
    }
});

// Spin-Logik
spinBtn.addEventListener('click', () => {
    if (isSpinning) return;
    if (balance < currentBet) {
        statusEl.textContent = 'Nicht genug Guthaben! Klicke oben auf +.';
        statusEl.classList.remove('status-win');
        return;
    }

    // Einsatz abziehen & Animation starten
    isSpinning = true;
    balance -= currentBet;
    updateUI();
    spinBtn.disabled = true;
    statusEl.textContent = 'Walzen drehen...';
    statusEl.classList.remove('status-win');

    const results = [getRandomSymbol(), getRandomSymbol(), getRandomSymbol()];

    // Alle Walzen drehen lassen
    reels.forEach(reel => reel.classList.add('spinning'));

    // Während des Drehens zufällige Symbole durchwechseln
    const spinInterval = setInterval(() => {
        reels.forEach(reel => {
            reel.querySelector('.symbols').textContent = getRandomSymbol().icon;
        });
    }, 80);

    // Walzen nacheinander stoppen
    reels.forEach((reel, index) => {
        setTimeout(() => {
            reel.classList.remove('spinning');
            reel.querySelector('.symbols').textContent = results[index].icon;

            // Wenn die letzte Walze stoppt
            if (index === reels.length - 1) {
                clearInterval(spinInterval);
                evaluateWin(results);
                isSpinning = false;
                spinBtn.disabled = false;
            }
        }, 1000 + index * 500);
    });
});

// Gewinn auswerten
function evaluateWin(results) {
    let winAmount = 0;

    // 3 Gleiche
    if (results[0].icon === results[1].icon && results[1].icon === results[2].icon) {
        winAmount = currentBet * results[0].multiplier;
        statusEl.textContent = `JACKPOT! 3x ${results[0].icon} -> +${winAmount} €!`;
        statusEl.classList.add('status-win');
    } 
    // 2 Kirschen als kleiner Trostgewinn
    else if (results.filter(r => r.icon === '🍒').length === 2) {
        winAmount = currentBet * 1.5;
        statusEl.textContent = `Kleiner Gewinn! 2x 🍒 -> +${winAmount} €`;
        statusEl.classList.add('status-win');
    } else {
        statusEl.textContent = 'Leider kein Gewinn. Versuch es nochmal!';
    }

    if (winAmount > 0) {
        balance += winAmount;
        lastWinEl.textContent = winAmount.toLocaleString('de-DE', { minimumFractionDigits: 2 }) + ' €';
        updateUI();
    }
}

// Start-UI laden
updateUI();
